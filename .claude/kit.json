{
  "_readme": "Kit v2 config. Read by .claude/hooks/*.ps1, .claude/scripts/*.ps1, the skills, and the agents. Run /customize-kit to fill it in. Empty values disable the related feature. Commands run from the project (or worktree) root via 'cmd.exe /c'. Placeholders: {file} = edited file (verify.fast), {tests} = space-separated test files (testAudit.run), {port} = per-task dev-server port (ui.*).",

  "verify": {
    "sourceExtensions": [],
    "fast": [],
    "full": [],
    "maxOutputLines": 60
  },

  "protectedPaths": [
    { "pattern": ".env", "reason": "Secrets file" },
    { "pattern": ".env.local", "reason": "Secrets file" },
    { "pattern": ".env.*.local", "reason": "Secrets file" },
    { "pattern": "*.pem", "reason": "Key material" },
    { "pattern": "*.key", "reason": "Key material" },
    { "pattern": "docs/tasks/INDEX.md", "reason": "Generated by .claude/scripts/build-index.ps1; edit task files instead" }
  ],

  "workflow": {
    "baseBranch": "main",
    "wipLimit": 2,
    "openPullRequests": true,
    "waitForCi": true,
    "maxCiFixRounds": 2,
    "unattendedPermissionMode": "acceptEdits",
    "worktreeSetup": [],
    "worktreeCopyFiles": []
  },

  "testAudit": {
    "testPathPatterns": ["*.test.*", "*.spec.*", "*/tests/*", "*/__tests__/*", "*/test_*.py", "*Test.java"],
    "run": ""
  },

  "ui": {
    "baseUrl": "",
    "startCommand": "",
    "portBase": 3100,
    "viewports": [
      { "name": "phone", "width": 390, "height": 844 },
      { "name": "desktop", "width": 1440, "height": 900 }
    ],
    "designFiles": []
  },

  "_examples": {
    "node_typescript": {
      "verify": {
        "sourceExtensions": [".ts", ".tsx", ".js", ".jsx"],
        "fast": ["npx tsc --noEmit --pretty false", "npx eslint {file}"],
        "full": ["npm run typecheck", "npm run lint", "npm test", "npm run build"]
      },
      "workflow": { "worktreeSetup": ["npm ci"], "worktreeCopyFiles": [".env.local"] },
      "testAudit": { "run": "npx vitest run {tests}" },
      "ui": { "baseUrl": "http://localhost:{port}", "startCommand": "npm run dev -- --port {port}", "designFiles": ["design/mockups.html"] }
    },
    "python": {
      "verify": { "sourceExtensions": [".py"], "fast": ["ruff check {file}"], "full": ["ruff check .", "mypy .", "pytest -q"] },
      "workflow": { "worktreeSetup": ["python -m venv .venv", ".venv\\Scripts\\pip install -r requirements.txt"] },
      "testAudit": { "run": "pytest -q {tests}" }
    },
    "java_gradle": {
      "verify": { "sourceExtensions": [".java", ".kt"], "fast": ["gradlew.bat compileJava -q"], "full": ["gradlew.bat check"] },
      "testAudit": { "run": "gradlew.bat test" }
    },
    "protected_migration": { "pattern": "drizzle/0*.sql", "reason": "Applied migrations are immutable; create a new migration instead" }
  }
}
