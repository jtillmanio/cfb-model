{
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm db:check)",
      "Bash(pnpm db:check *)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm build)",
      "Bash(pnpm build *)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm --dir web exec eslint *)",
      "Bash(uv --directory python run ruff check *)",
      "Bash(uv run pytest *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm exec vitest run *)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(uv --directory python sync)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch -m *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push -u origin model/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr ready *)",
      "Bash(gh run view *)",
      "Bash(gh workflow run *)",
      "Bash(gh run watch *)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm typecheck *)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm db:check)",
      "PowerShell(pnpm db:check *)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test *)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm build *)",
      "PowerShell(pnpm test:e2e)",
      "PowerShell(pnpm test:e2e *)",
      "PowerShell(pnpm --dir web exec eslint *)",
      "PowerShell(uv --directory python run ruff check *)",
      "PowerShell(uv run pytest *)",
      "PowerShell(pnpm exec playwright test *)",
      "PowerShell(pnpm exec vitest run *)",
      "PowerShell(pnpm install --frozen-lockfile)",
      "PowerShell(uv --directory python sync)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git branch -m *)",
      "PowerShell(git push -u origin feat/*)",
      "PowerShell(git push -u origin fix/*)",
      "PowerShell(git push -u origin chore/*)",
      "PowerShell(git push -u origin docs/*)",
      "PowerShell(git push -u origin model/*)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr ready *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run watch *)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin master)",
      "Bash(git push origin master *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(gh workflow run release.yml*)",
      "Bash(vercel deploy*)",
      "Bash(vercel --prod*)",
      "Bash(vercel promote*)",
      "Bash(*--env-file .env.live*)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin master)",
      "PowerShell(git push origin master *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --force-with-lease *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean -fdx *)",
      "PowerShell(git add -A*)",
      "PowerShell(git add --all*)",
      "PowerShell(git add .)",
      "PowerShell(git commit -a*)",
      "PowerShell(git commit --all*)",
      "PowerShell(gh workflow run release.yml*)",
      "PowerShell(vercel deploy*)",
      "PowerShell(vercel --prod*)",
      "PowerShell(vercel promote*)",
      "PowerShell(*--env-file .env.live*)",
      "Read(./.env.live)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-large-reads.ps1\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-verify.ps1\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
